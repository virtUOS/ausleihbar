#
# Security headers for Ausleihbar (issue #44), imported by the Caddyfile:
#   import /etc/caddy/security-headers.caddy   (top level)
#   import security_headers                     (site block)
#   import spa_csp                              (SPA handle block)
#   import media_csp                            (/media handle block)
#   import admin_allowlist                      (/django-admin handle block)
# Kept separate from the Caddyfile so the header rules live in one file (both
# are maintained in git; neither needs local edits). The SPA CSP is
# report-only for now; #45 switches it to enforcing. Reports: Django admin → CSP violations.
#
# (security_headers) also caps request body sizes (#122): 30MB for /api/*,
# 2GB for the ZIP import (/api/manage/import/). Larger bodies get a 413 from
# Caddy, which stops forwarding at the limit, so Django never processes them.
# See docs/INSTALL.md ("Request size limits") for changing them (recreate the
# caddy container after an update).
#
# (security_headers) also sends HSTS. (admin_allowlist) restricts the Django
# admin to the source addresses in ADMIN_ALLOWED_CIDRS (docs/INSTALL.md,
# "Django admin access").

(security_headers) {
	header {
		# Applied after the upstream response. "?" sets a header only if absent,
		# so Django's stricter Referrer-Policy / X-Frame-Options survive on
		# /api, /django-admin and /oidc; the others are always set.
		defer
		X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		# The lending desk QR scanner needs the camera on our own origin.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# HSTS: browsers use HTTPS only for one year, so a first plain-HTTP
		# request can't be stripped. Set here only, because TLS terminates in
		# Caddy; Django's SECURE_HSTS_SECONDS stays off to avoid a second,
		# possibly conflicting header. No "preload" (hard to undo).
		# includeSubDomains: every subdomain of the site's host must serve HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Request body limits (#122). The two matchers are mutually exclusive on
	# purpose: every matching request_body applies, so an overlapping /api/*
	# limit would also cap the import. The largest app-level upload limit is
	# 25 MiB (product attribute PDFs); 30MB leaves room for multipart
	# overhead. The admin ZIP import (structure + inventory + media) gets 2GB.
	@api_body {
		path /api/*
		not path /api/manage/import/
	}
	request_body @api_body {
		max_size 30MB
	}
	@import_body path /api/manage/import/
	request_body @import_body {
		max_size 2GB
	}
}

(spa_csp) {
	# report-to / Reporting-Endpoints are deliberately left out for now:
	# Chromium ignores report-uri as soon as report-to is present, and
	# report-to delivery was not observed to work over plain HTTP. Only
	# report-uri is used (all engines). Revisit in #45 after verifying
	# report-to delivery over HTTPS.
	header {
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report/"
	}
}

(media_csp) {
	# Enforced sandbox for uploads (images, the SVG logo, rich-text images):
	# they render as <img> as before, but a directly opened file cannot run
	# script on our origin. PDFs (/product-docs/*.pdf, opened directly by
	# borrowers) are exempt: Firefox (pdf.js) and Safari can fail to render
	# sandboxed documents. They keep nosniff and X-Frame-Options.
	# (Inside handle_path /media/*, so the path is already stripped of /media.)
	@media_not_pdf not path *.pdf
	header @media_not_pdf Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
}

(admin_allowlist) {
	# Django admin (/django-admin/, password login of the break-glass
	# superuser) only from the networks in ADMIN_ALLOWED_CIDRS — set in .env,
	# forwarded to the caddy service by docker-compose.prod.yml; space-separated
	# IPs/CIDRs, IPv4 and IPv6. Everyone else gets 403 before Django is reached.
	# Imported as the first line of the `handle /django-admin/*` block. The
	# route block keeps the check ahead of the block's reverse_proxy regardless
	# of Caddy's directive order.
	#
	# Unset/empty variable = deny all (secure default). 255.255.255.255/32 is a
	# never-matching placeholder so the matcher stays valid when the variable
	# is empty. remote_ip is the direct peer address: Caddy is the edge proxy,
	# so no trusted_proxies / X-Forwarded-For is involved. Never allow the
	# Docker network range (e.g. 172.16.0.0/12): connections Docker proxies
	# itself (IPv6 without Docker IPv6, hairpin) arrive from its gateway.
	route {
		@admin_not_allowed not remote_ip 255.255.255.255/32 {$ADMIN_ALLOWED_CIDRS}
		respond @admin_not_allowed "Forbidden" 403
	}
}
