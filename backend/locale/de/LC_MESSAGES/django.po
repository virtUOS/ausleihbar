"deine Buchung %(code)s ist bestätigt. Bitte hole deine Gegenstände innerhalb "
"der Öffnungszeiten des Pools ab."

#: lending/notifications.py:265
#, python-format
msgid ""
"A note from the lending team:\n"
"%(msg)s"
msgstr ""
