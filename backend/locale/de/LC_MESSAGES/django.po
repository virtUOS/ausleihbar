#: lending/notifications.py:248
#, python-format
msgid ""
"your reservation %(code)s is confirmed. Please pick up your item(s) during "
"the opening hours below."
msgstr ""
"deine Reservierung %(code)s ist bestätigt. Bitte hole deine Gegenstände "
"innerhalb der unten genannten Öffnungszeiten ab."

#: lending/notifications.py:253
#, python-format
msgid ""
"your reservation %(code)s is confirmed. Please pick up your item(s) during "
"the pool's opening hours."
msgstr ""
"deine Reservierung %(code)s ist bestätigt. Bitte hole deine Gegenstände "
"innerhalb der Öffnungszeiten des Pools ab."

#: lending/notifications.py:259
#, python-format
msgid ""
"A note from the lending team:\n"
"%(msg)s"
msgstr ""
"Eine Nachricht vom Verleihteam:\n"
"%(msg)s"

#: lending/notifications.py:261
#, python-format
msgid ""
"At pickup, show your booking number %(code)s — the attached QR code can be "
"scanned by the lending desk. The attached calendar entry (.ics) adds the "
"lending period to your calendar."
msgstr ""
"Zeige bei der Abholung deine Buchungsnummer %(code)s — der angehängte "
"QR-Code kann an der Verleihtheke gescannt werden. Mit dem angehängten "
"Kalendereintrag (.ics) übernimmst du den Ausleihzeitraum in deinen Kalender."

#: lending/notifications.py:311
msgid ""
"we received your reservation. It is on hold and the lending team will "
"confirm it shortly."
msgstr ""
"wir haben deine Reservierung erhalten. Sie ist vorgemerkt und wird vom "
"Verleihteam in Kürze bestätigt."

#: lending/notifications.py:316
msgid "Each pool confirms its part of your order separately."
msgstr "Jeder Pool bestätigt seinen Teil deiner Bestellung separat."

#: lending/notifications.py:318
#, python-format
msgid "Booking number: %(code)s"
msgstr "Buchungsnummer: %(code)s"

#: lending/notifications.py:322 lending/notifications.py:390
#, python-format
msgid "Your message: %(note)s"
msgstr "Deine Nachricht: %(note)s"

#: lending/notifications.py:352
#, python-format
msgid "Ausleihbar reservation %(code)s received (awaiting confirmation)"
msgstr "Ausleihbar-Reservierung %(code)s eingegangen (wartet auf Bestätigung)"

#: lending/notifications.py:356
#, python-format
msgid "Ausleihbar order received: %(codes)s (awaiting confirmation)"
msgstr "Ausleihbar-Bestellung eingegangen: %(codes)s (wartet auf Bestätigung)"

#: lending/notifications.py:376
msgid "PARTIAL CONFIRMATION — only part of your order is confirmed so far."
msgstr "TEILBESTÄTIGUNG — bisher ist nur ein Teil deiner Bestellung bestätigt."

#: lending/notifications.py:380
#, python-format
msgid "Still awaiting confirmation: %(pool)s (%(code)s)"
msgstr "Noch nicht bestätigt: %(pool)s (%(code)s)"

#: lending/notifications.py:429
#, python-format
msgid "Ausleihbar — partial confirmation: %(codes)s"
msgstr "Ausleihbar — Teilbestätigung: %(codes)s"

#: lending/notifications.py:436
#, python-format
msgid "Ausleihbar reservations %(codes)s confirmed — pickup details"
msgstr "Ausleihbar-Reservierungen %(codes)s bestätigt — Abholdetails"

#: lending/notifications.py:440
#, python-format
msgid "Ausleihbar reservation %(code)s confirmed — pickup details"
msgstr "Ausleihbar-Reservierung %(code)s bestätigt — Abholdetails"

#: lending/notifications.py:474
#, python-format
msgid ""
"an item reserved on your booking %(code)s has become unavailable (defect) "
"and we could not move it to another unit:"
msgstr ""
"ein für deine Buchung %(code)s reservierter Gegenstand ist nicht mehr "
"verfügbar (defekt) und konnte nicht auf ein anderes Exemplar umgebucht "
"werden:"

#: lending/notifications.py:479 lending/notifications.py:635
msgid "Please contact the lending team to arrange an alternative:"
msgstr "Bitte kontaktiere das Verleihteam, um eine Alternative zu vereinbaren:"

#: lending/notifications.py:482
#, python-format
msgid "Ausleihbar reservation %(code)s — reserved item unavailable"
msgstr ""
"Ausleihbar-Reservierung %(code)s — reservierter Gegenstand nicht verfügbar"

#: lending/notifications.py:496
#, python-format
msgid ""
"an item reserved on your booking %(code)s may not be available at pickup: it "
"has not yet been returned and we could not move your booking to another unit:"
msgstr ""
"ein für deine Buchung %(code)s reservierter Gegenstand ist bei der Abholung "
"möglicherweise nicht verfügbar: er wurde noch nicht zurückgegeben und deine "
"Buchung konnte nicht auf ein anderes Exemplar umgebucht werden:"

#: lending/notifications.py:502
msgid "Please contact the lending team before you come by:"
msgstr "Bitte kontaktiere das Verleihteam, bevor du vorbeikommst:"

#: lending/notifications.py:505
#, python-format
msgid "Ausleihbar reservation %(code)s — reserved item may be unavailable"
msgstr ""
"Ausleihbar-Reservierung %(code)s — reservierter Gegenstand eventuell nicht "
"verfügbar"

#: lending/notifications.py:524 lending/notifications.py:556
#: lending/notifications.py:653
