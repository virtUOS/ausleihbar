msgstr ""
"aufgrund einer Schließung am %(when)s mussten wir deine Reservierung "
"%(code)s umbuchen:"

#: lending/notifications.py:612
#, python-format
msgid "before: %(period)s"
msgstr "vorher: %(period)s"

#: lending/notifications.py:613
#, python-format
msgid "now: %(period)s"
msgstr "jetzt: %(period)s"

#: lending/notifications.py:616
#, python-format
