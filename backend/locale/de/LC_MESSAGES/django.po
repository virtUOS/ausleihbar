#: accounts/strikes.py:78
msgid "Your account is now blocked indefinitely."
msgstr "Dein Konto ist jetzt dauerhaft gesperrt."

#: accounts/strikes.py:80
#, python-format
msgid "Your account is blocked until %(date)s."
msgstr "Dein Konto ist bis zum %(date)s gesperrt."

#: accounts/strikes.py:84
msgid "No borrowing block applies yet."
msgstr "Es gilt noch keine Ausleihsperre."

#: accounts/strikes.py:86
#, python-format
msgid ""
"A strike was added to your account.\n"
"\n"
"Reason: %(reason)s\n"
"\n"
msgstr ""
"Deinem Konto wurde ein Strike hinzugefügt.\n"
"\n"
"Grund: %(reason)s\n"
"\n"

#: accounts/strikes.py:89
msgid "You received a strike"
msgstr "Du hast einen Strike erhalten"

#: lending/notifications.py:55 lending/notifications.py:60
msgid "open end"
msgstr "offenes Ende"

#: lending/notifications.py:101
#, python-format
msgid "Pickup at %(pool)s"
msgstr "Abholung bei %(pool)s"

#: lending/notifications.py:113
msgid "Address:"
msgstr "Adresse:"

#: lending/notifications.py:120
msgid "Opening hours:"
msgstr "Öffnungszeiten:"

#: lending/notifications.py:124
#, python-format
msgid "Directions: %(text)s"
msgstr "Wegbeschreibung: %(text)s"

#: lending/notifications.py:128
#, python-format
msgid "Contact: %(contact)s"
msgstr "Kontakt: %(contact)s"

#: lending/notifications.py:173
msgid "there"
msgstr "zusammen"

#: lending/notifications.py:184
#, python-format
msgid ""
"your reservation %(code)s is confirmed. Please pick up your item(s) during "
"the opening hours below."
msgstr ""
"deine Reservierung %(code)s ist bestätigt. Bitte hole deine Artikel "
"innerhalb der unten genannten Öffnungszeiten ab."

#: lending/notifications.py:191 lending/notifications.py:261
msgid ""
"we received your reservation. It is on hold and the lending team will "
"confirm it shortly."
msgstr ""
"wir haben deine Reservierung erhalten. Sie ist vorgemerkt und wird vom "
"Verleih-Team in Kürze bestätigt."

#: lending/notifications.py:196 lending/notifications.py:265
#: lending/notifications.py:355 lending/notifications.py:388
#: lending/notifications.py:498 lending/notifications.py:534
#: lending/notifications.py:597
#, python-format
msgid "Hi %(name)s,"
msgstr "Hallo %(name)s,"

#: lending/notifications.py:199 lending/notifications.py:270
#, python-format
msgid "Reservation number: %(code)s"
msgstr "Reservierungsnummer: %(code)s"

#: lending/notifications.py:202
#, python-format
msgid ""
"A note from the lending team:\n"
"%(msg)s"
msgstr ""
"Eine Nachricht vom Verleih-Team:\n"
"%(msg)s"

#: lending/notifications.py:204 lending/notifications.py:274
#, python-format
msgid "Your message: %(note)s"
msgstr "Deine Nachricht: %(note)s"

#: lending/notifications.py:207
#, python-format
msgid ""
"At pickup, show your code %(code)s — the attached QR code can be scanned by "
"the lending desk."
msgstr ""
"Zeige bei der Abholung deinen Code %(code)s — der angehängte QR-Code kann an "
"der Ausleihtheke gescannt werden."

#: lending/notifications.py:210 lending/notifications.py:275
#: lending/notifications.py:369 lending/notifications.py:403
#: lending/notifications.py:516 lending/notifications.py:548
#: lending/notifications.py:609
#, python-format
msgid "View your bookings: %(url)s"
msgstr "Deine Buchungen ansehen: %(url)s"

#: lending/notifications.py:268
msgid "Each pool confirms its part of your order separately."
msgstr "Jeder Pool bestätigt seinen Teil deiner Bestellung separat."

#: lending/notifications.py:305
#, python-format
msgid "Ausleihbar reservation %(code)s received (awaiting confirmation)"
msgstr "Ausleihbar-Reservierung %(code)s eingegangen (wartet auf Bestätigung)"

#: lending/notifications.py:309
#, python-format
msgid "Ausleihbar order received: %(codes)s (awaiting confirmation)"
msgstr "Ausleihbar-Bestellung eingegangen: %(codes)s (wartet auf Bestätigung)"

#: lending/notifications.py:332
#, python-format
msgid "Ausleihbar reservation %(code)s confirmed — pickup details"
msgstr "Ausleihbar-Reservierung %(code)s bestätigt — Abholdetails"

#: lending/notifications.py:358
#, python-format
msgid ""
"a device reserved on your booking %(code)s has become unavailable (defect) "
"and we could not move it to another unit:"
msgstr ""
"ein für deine Buchung %(code)s reserviertes Gerät ist nicht mehr verfügbar "
"(defekt) und konnte nicht auf ein anderes Exemplar umgebucht werden:"

#: lending/notifications.py:364 lending/notifications.py:543
msgid "Please contact the lending pool to arrange an alternative:"
msgstr ""
"Bitte kontaktiere den Verleih-Pool, um eine Alternative zu vereinbaren:"

#: lending/notifications.py:376
#, python-format
msgid "Ausleihbar reservation %(code)s — reserved device unavailable"
msgstr "Ausleihbar-Reservierung %(code)s — reserviertes Gerät nicht verfügbar"

#: lending/notifications.py:391
#, python-format
msgid ""
"a device reserved on your booking %(code)s may not be available at pickup: "
"it has not yet been returned and we could not move your booking to another "
"unit:"
msgstr ""
"ein für deine Buchung %(code)s reserviertes Gerät ist bei der Abholung "
"möglicherweise nicht verfügbar: es wurde noch nicht zurückgegeben und konnte "
"nicht auf ein anderes Exemplar umgebucht werden:"

#: lending/notifications.py:398
msgid "Please contact the lending pool before you come by:"
msgstr "Bitte kontaktiere den Verleih-Pool, bevor du vorbeikommst:"

#: lending/notifications.py:409
#, python-format
msgid "Ausleihbar reservation %(code)s — reserved device may be unavailable"
msgstr ""
"Ausleihbar-Reservierung %(code)s — reserviertes Gerät eventuell nicht "
"verfügbar"

#: lending/notifications.py:425 lending/notifications.py:456
#: lending/notifications.py:567
msgid "Hi,"
msgstr "Hallo,"

#: lending/notifications.py:427
#, python-format
msgid "a resource in %(pool)s was marked defective:"
msgstr "eine Ressource in %(pool)s wurde als defekt markiert:"

#: lending/notifications.py:432
#, python-format
msgid "Note: %(note)s"
msgstr "Hinweis: %(note)s"

#: lending/notifications.py:434
#, python-format
msgid "Ausleihbar — device marked defective in %(pool)s"
msgstr "Ausleihbar — Gerät als defekt markiert in %(pool)s"

#: lending/notifications.py:459
#, python-format
msgid ""
"%(borrower)s cancelled reservation %(code)s. The following item(s) from "
"%(pool)s are free again:"
msgstr ""
"%(borrower)s hat die Reservierung %(code)s storniert. Die folgenden Artikel "
"aus %(pool)s sind wieder frei:"

#: lending/notifications.py:465
#, python-format
msgid "Open the lending desk: %(url)s"
msgstr "Verleihtheke öffnen: %(url)s"

#: lending/notifications.py:470
#, python-format
msgid "Ausleihbar — reservation %(code)s cancelled by %(borrower)s"
msgstr "Ausleihbar — Reservierung %(code)s storniert von %(borrower)s"

#: lending/notifications.py:501
#, python-format
msgid ""
"because of a closure on %(when)s we had to reschedule your reservation "
"%(code)s:"
msgstr ""
"aufgrund einer Schließung am %(when)s mussten wir deine Reservierung "
"%(code)s umbuchen:"

#: lending/notifications.py:523
#, python-format
msgid "Ausleihbar reservation %(code)s — rescheduled due to a closure"
msgstr "Ausleihbar-Reservierung %(code)s — umgebucht wegen einer Schließung"

#: lending/notifications.py:537
#, python-format
msgid ""
"because of a closure on %(when)s your reservation %(code)s had to be "
"cancelled:"
msgstr ""
"aufgrund einer Schließung am %(when)s musste deine Reservierung %(code)s "
"storniert werden:"

#: lending/notifications.py:555
#, python-format
msgid "Ausleihbar reservation %(code)s — cancelled due to a closure"
msgstr "Ausleihbar-Reservierung %(code)s — storniert wegen einer Schließung"

#: lending/notifications.py:570
#, python-format
msgid ""
"these resources in %(pool)s have been defective for a while. Please retire "
"them or return them to service:"
msgstr ""
"diese Ressourcen in %(pool)s sind schon länger defekt. Bitte setze sie außer "
"Betrieb oder wieder in Betrieb:"

#: lending/notifications.py:576
msgid "no note"
msgstr "kein Hinweis"

#: lending/notifications.py:577
#, python-format
msgid "defective since %(date)s"
msgstr "defekt seit %(date)s"

#: lending/notifications.py:583
#, python-format
msgid "Ausleihbar — defective resources in %(pool)s need review"
msgstr "Ausleihbar — defekte Ressourcen in %(pool)s müssen überprüft werden"

#: lending/notifications.py:599
#, python-format
msgid "this is a reminder about your reservation %(code)s."
msgstr "dies ist eine Erinnerung an deine Reservierung %(code)s."

#: lending/notifications.py:603
msgid "Not yet picked up (overdue):"
msgstr "Noch nicht abgeholt (überfällig):"

#: lending/notifications.py:606
msgid "Not yet returned (overdue) — please bring them back:"
msgstr "Noch nicht zurückgegeben (überfällig) — bitte zurückbringen:"

#: lending/notifications.py:615
#, python-format
msgid "Ausleihbar reservation %(code)s — overdue reminder"
msgstr "Ausleihbar-Reservierung %(code)s — Erinnerung an Überfälligkeit"
