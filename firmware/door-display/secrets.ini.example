;
; Copy to secrets.ini (git-ignored) and fill in. Values are compiled into the
; firmware; changing them means reflashing. Without secrets.ini the build uses
; the placeholder values from [secrets] in platformio.ini.
;
; Avoid double quotes and backslashes in the values (they end up in a C string).

[secrets]
wifi_ssid = door-displays
wifi_pass = change-me
; Base URL of the Ausleihbar backend, without a trailing slash.
server_url = https://ausleihbar.example.org

; Bench setup against the local dev backend (plain HTTP, no certificate check):
; server_url = http://192.168.1.23:8001
; dev_flags = -DDOOR_DEV_INSECURE=1 -DDOOR_DEBUG=1
dev_flags =
