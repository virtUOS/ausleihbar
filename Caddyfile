# Caddyfile — Ausleihbar production reverse proxy with automatic HTTPS.
#
# Replace ausleihbar.example.org with your domain and set a real ACME contact
# email. Caddy obtains and renews a Let's Encrypt certificate automatically as
# long as ports 80 and 443 are reachable and the domain's DNS points here.

{
	# Contact address for Let's Encrypt (expiry notices). Replace it.
	email admin@example.org
}

# Security header snippets (#44); kept in git so header changes need no Caddyfile edit.
import /etc/caddy/security-headers.caddy

ausleihbar.example.org {
	encode zstd gzip
	import security_headers

	# API, Django admin (/django-admin/ — /admin/ belongs to the SPA, #48) and the
	# OIDC endpoints → Django (gunicorn).
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /django-admin/* {
		reverse_proxy backend:8000
	}
	handle /oidc/* {
		reverse_proxy backend:8000
	}

	# Uploaded media and collected static files → served directly from volumes.
	handle_path /media/* {
		import media_csp
		root * /srv/media
		file_server
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Everything else → the built SPA, with client-side routing fallback.
	handle {
		import spa_csp
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
